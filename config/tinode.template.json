{
  "listen": ":6060",
  "api_path": "/",
  "grpc_listen": "",
  "api_key_salt": "GENERATED_BY_SETUP",
  "max_message_size": 131072,
  "max_subscriber_count": 128,
  "max_tag_count": 16,
  "permanent_accounts": false,
  "expvar": "-",
  "server_status": "-",
  "use_x_forwarded_for": false,
  "p2p_delete_enabled": true,
  "msg_delete_age": 600,
  "alias_tag": "alias",
  "auth_config": {
    "logical_names": ["anon:", "rest:", "code:"],
    "basic": {
      "add_to_tags": true,
      "min_login_length": 4,
      "min_password_length": 8
    },
    "token": {
      "expire_in": 1209600,
      "serial_num": 1,
      "key": "GENERATED_BY_SETUP"
    }
  },
  "store_config": {
    "uid_key": "GENERATED_BY_SETUP",
    "max_results": 1024,
    "use_adapter": "postgres",
    "adapters": {
      "postgres": {
        "dsn": "GENERATED_BY_SETUP",
        "max_open_conns": 16,
        "max_idle_conns": 8,
        "conn_max_lifetime": 60,
        "sql_timeout": 10
      }
    }
  },
  "media": {
    "use_handler": "fs",
    "max_size": 16777216,
    "gc_period": 60,
    "gc_block_size": 100,
    "handlers": {
      "fs": {
        "upload_dir": "GENERATED_BY_SETUP",
        "cache_control": "private, max-age=86400",
        "cors_origins": ["*"]
      }
    }
  },
  "acc_validation": {},
  "push": [],
  "plugins": [],
  "tls": {"enabled": false},
  "webrtc": {"enabled": false}
}
